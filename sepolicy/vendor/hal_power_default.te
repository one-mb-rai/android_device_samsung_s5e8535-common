allow hal_power_default pm_qos_device:chr_file rw_file_perms;

allow hal_power_default sysfs_battery:dir search;
allow hal_power_default sysfs_battery_writable:file rw_file_perms;

allow hal_power_default sysfs_battery:lnk_file read;

# TSP / Touchscreen DT2W
allow hal_power_default sysfs_touchscreen_writable:file rw_file_perms;
allow hal_power_default sysfs_sec_touchscreen:dir search;
allow hal_power_default sysfs_sec_touchscreen:file rw_file_perms;
allow hal_power_default sysfs_sec_touchscreen:lnk_file r_file_perms;
